{
  "manifest_version": 3,
  "name": "Yandex Mail Personalizer",
  "version": "1.0.3",
  "description": "Полуавтоматическая подготовка персонализированных писем в Яндекс.Почте по списку из .txt файла.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://mail.yandex.ru/*",
    "https://mail.yandex.com/*",
    "https://mail.yandex.by/*",
    "https://mail.yandex.kz/*",
    "https://mail.yandex.ua/*"
  ],
  "action": {
    "default_title": "Yandex Mail Personalizer",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.yandex.ru/*",
        "https://mail.yandex.com/*",
        "https://mail.yandex.by/*",
        "https://mail.yandex.kz/*",
        "https://mail.yandex.ua/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}